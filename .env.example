# Hass-Eedomus Environment Configuration
# Copy this file to .env and customize the values for your setup
# This file is excluded from git (see .gitignore)

# =============================================================================
# REQUIRED: Remote Server Configuration
# =============================================================================
# IP address or hostname of your Home Assistant server (Raspberry Pi)
REMOTE_IP=your.homeassistant.ip

# SSH username for connecting to the remote server
REMOTE_USER=your_ssh_username

# SSH port (default: 22)
REMOTE_PORT=22

# =============================================================================
# REQUIRED: Path Configuration
# =============================================================================
# Path to the hass-eedomus directory on the remote server
REMOTE_PATH=/path/to/homeassistant/custom_components/hass-eedomus

# Path to the custom_components directory on the remote server
REMOTE_COMPONENTS_PATH=/path/to/homeassistant/custom_components

# Local path to your hass-eedomus repository
LOCAL_REPO_PATH=/path/to/local/hass-eedomus

# =============================================================================
# OPTIONAL: SSH Configuration
# =============================================================================
# Additional SSH options (e.g., for non-standard configurations)
# Example: -o ConnectTimeout=10 -o ConnectionAttempts=3
SSH_OPTS=""

# =============================================================================
# OPTIONAL: Logging Configuration
# =============================================================================
# Path to local log file for storing remote logs
LOG_FILE=~/hass-eedomus-deploy.log

# =============================================================================
# EXAMPLE: Typical Configuration
# =============================================================================
# For a standard setup with Raspberry Pi at 192.168.1.5:
# REMOTE_IP=192.168.1.5
# REMOTE_USER=pi
# REMOTE_PORT=22
# REMOTE_PATH=/homeassistant/custom_components/hass-eedomus
# REMOTE_COMPONENTS_PATH=/homeassistant/custom_components
# LOCAL_REPO_PATH=/Users/yourname/mistral/hass-eedomus

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with your specific configuration
#
# 3. The .env file will be automatically loaded by deployment scripts
#
# 4. NEVER commit the .env file to git (it's in .gitignore)
#
# 5. For security, set restrictive permissions:
#    chmod 600 .env
